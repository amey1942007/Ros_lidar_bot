# Copy to the robot as /etc/amr-bridge.env (chmod 600).
# Real values were generated during setup — ask the repo owner for the token
# or regenerate via Supabase SQL (update amr_bridge_config.token_sha256).

AMR_BOT_ID=hardware-bot
AMR_SUPABASE_URL=https://khucmrlbstdlbxcuboub.supabase.co
# Publishable key (safe for the Pi; not the service_role key)
AMR_SUPABASE_KEY=sb_publishable_REPLACE_ME
# Shared bridge token (sha256 stored in public.amr_bridge_config)
AMR_BRIDGE_TOKEN=REPLACE_WITH_BRIDGE_TOKEN
# Bridge Auth user for private channels. app_metadata is set out of band.
# Names only here — never commit a real password.
AMR_BRIDGE_EMAIL=REPLACE_WITH_BRIDGE_EMAIL
AMR_BRIDGE_PASSWORD=REPLACE_WITH_BRIDGE_PASSWORD
# 0 is the default: public *commands* stay off. Rank there is client-supplied
# (spoofable), and that path has no 0.5 s deadman.
# Telemetry, map, log, and hb are still published on amr-bot-<id>.
# 1 also listens for commands on that topic during cut-over.
AMR_PUBLIC_CHANNEL=0
# /scan on telemetry: keep at most this many points (clamped 20..360).
AMR_SCAN_MAX_POINTS=90
# How often a full-rate telemetry frame includes scan (clamped 1..10).
# Other frames send "scan": null.
AMR_SCAN_HZ=5
# Drop camera, then scan, then frontier/yolo/sem/path above this many bytes
# (clamped 20000..250000, under the 256 KB Realtime broadcast limit).
AMR_TELEMETRY_MAX_BYTES=200000
# 1 also POSTs public broadcasts to /realtime/v1/api/broadcast at most 5 Hz.
AMR_PUBLIC_REST=0
# Do not set AMR_SUPABASE_SERVICE_KEY. The bridge ignores it.
AMR_DASHBOARD_URL=http://127.0.0.1:8080
# Full Xbox /joy path (web_gamepad_node). Without this, joy falls back to nudge.
AMR_GAMEPAD_URL=http://127.0.0.1:8765
# Optional public camera (Cloudflare Tunnel / Tailscale Funnel):
# AMR_CAMERA_URL=https://cam-amr4.example/camera.mjpg
# AMR_CAMERA_JPEG_MAX_KB=24
