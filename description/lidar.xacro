<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =======================================================================
       LIDAR POSITION — FILL IN YOUR VALUES (metres)
       Reference Point:
         Measure X, Y, Z offsets relative to the 'base_link' origin.
         - 'base_link' is located at the center of the bottom face of the chassis box.
         - X: distance forward from the center of the chassis bottom (positive front, negative back).
         - Y: distance left from the center of the chassis bottom (positive left, negative right).
         - Z: height upwards from the center of the chassis bottom face.
       ======================================================================= -->
  <xacro:property name="laser_x"      value="0.0"/>  <!-- forward/back  -->
  <xacro:property name="laser_y"      value="0.0"/>  <!-- left/right    -->

  <!-- Lidar cylinder dimensions (default ~RPLidar A1) -->
  <xacro:property name="laser_radius" value="0.035"/> <!-- 70 mm diameter -->
  <xacro:property name="laser_height" value="0.040"/> <!-- 40 mm tall     -->

  <!-- Default: mounted ON TOP of the chassis. Must be above the chassis top
       (chassis_height) or the chassis blocks every ray and /scan is empty. -->
  <xacro:property name="laser_z"      value="${chassis_height + laser_height/2}"/>

  <!-- ============================================================
       LIDAR JOINT & LINK
       ============================================================ -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_frame"/>
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="${(1.0/12.0)*0.2*(3*laser_radius*laser_radius + laser_height*laser_height)}"
        iyy="${(1.0/12.0)*0.2*(3*laser_radius*laser_radius + laser_height*laser_height)}"
        izz="${(1.0/2.0)*0.2*laser_radius*laser_radius}"
        ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </link>

  <!-- Gazebo GPU lidar -> Gazebo topic "scan" (bridged to ROS /scan) -->
  <gazebo reference="laser_frame">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <ignition_frame_id>laser_frame</ignition_frame_id>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

</robot>
