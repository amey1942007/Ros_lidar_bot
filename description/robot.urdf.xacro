<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr4">

  <!--
    AMR4 top-level URDF/xacro
    Platform  : Jetson Orin Nano
    OS        : Ubuntu 22.04
    ROS       : ROS 2 Humble
    Drive     : 4-wheel mecanum (no caster wheels, no camera)

    Fill-in checklist (search for TODO_FILL):
      slam.xacro   — chassis size, wheel geometry, wheel positions
      imu.xacro    — IMU X/Y/Z position on chassis
      lidar.xacro  — LiDAR X/Y/Z position, yaw
  -->

  <!-- Core chassis + 4 wheels -->
  <xacro:include filename="$(find Ros_lidar_bot)/description/slam.xacro"/>

  <!-- LiDAR link -->
  <xacro:include filename="$(find Ros_lidar_bot)/description/lidar.xacro"/>

  <!-- IMU link -->
  <xacro:include filename="$(find Ros_lidar_bot)/description/imu.xacro"/>

</robot>
