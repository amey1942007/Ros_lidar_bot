<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =======================================================================
       IMU POSITION — FILL IN YOUR VALUES (metres)

       Reference frame:
         'base_link' is at the centre of the BOTTOM FACE of the chassis box.
         X : forward from chassis centre  (+front, -rear)
         Y : left from chassis centre     (+left,  -right)
         Z : height above chassis bottom  (upward positive)

       How to measure:
         1. Place the bot on a flat surface.
         2. Find the IMU chip/PCB mounting point.
         3. Measure its X/Y/Z offset from the chassis bottom-centre.
       ======================================================================= -->

  <!-- IMU position relative to base_link  (FILL IN) -->
  <xacro:property name="imu_x"  value="TODO_FILL"/>   <!-- e.g.  0.05  -->
  <xacro:property name="imu_y"  value="TODO_FILL"/>   <!-- e.g.  0.0   -->
  <xacro:property name="imu_z"  value="TODO_FILL"/>   <!-- e.g.  0.12  -->

  <!-- IMU orientation offset (FILL IN if the IMU is not mounted flat)
       Leave all zeros if the IMU X axis points robot-forward and Z is up. -->
  <xacro:property name="imu_roll"  value="0.0"/>
  <xacro:property name="imu_pitch" value="0.0"/>
  <xacro:property name="imu_yaw"   value="0.0"/>

  <!-- IMU PCB box size — only used for visualisation (FILL IN or leave as-is) -->
  <xacro:property name="imu_size_x" value="0.030"/>   <!-- 30 mm long -->
  <xacro:property name="imu_size_y" value="0.020"/>   <!-- 20 mm wide -->
  <xacro:property name="imu_size_z" value="0.004"/>   <!--  4 mm tall -->

  <!-- ============================================================
       IMU JOINT & LINK
       ============================================================ -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}"
            rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_size_x} ${imu_size_y} ${imu_size_z}"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_size_x} ${imu_size_y} ${imu_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.010"/>
      <inertia
        ixx="${(1.0/12.0)*0.01*(imu_size_y*imu_size_y + imu_size_z*imu_size_z)}"
        iyy="${(1.0/12.0)*0.01*(imu_size_x*imu_size_x + imu_size_z*imu_size_z)}"
        izz="${(1.0/12.0)*0.01*(imu_size_x*imu_size_x + imu_size_y*imu_size_y)}"
        ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </link>

</robot>