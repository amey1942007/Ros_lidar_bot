+  .op-pad-head h1 { font-size: 12px; gap: 4px; }
+  .op-pad-head .op-bot-label { display: none; }
+  .op-pad-head .op-home { padding: 2px 8px; font-size: 11px; }
+  .op-pad-head .op-switch button { padding: 2px 8px; font-size: 10px; height: 26px; }
+  .op-pad-head .op-grow { gap: 6px; flex-wrap: nowrap; }
+  .op-pad-head .pill { height: 22px; font-size: 10px; padding: 2px 8px; }
+  .op-pad-head .btn { padding: 4px 10px; font-size: 11px; }
+  .op-pad-head .btn.ghost { padding: 4px 8px; }
+  .op-pad-head .op-estop {
+    height: 28px; min-width: 72px; padding: 0 10px; font-size: 11px;
+  }
+  .xb-page-root {
+    flex: 1; min-height: 0; padding: 2px 8px 4px;
+    display: flex; align-items: stretch; justify-content: center;
+    overflow: hidden;
+  }
+  .xb-panel.xb-page {
+    width: 100%; max-width: none;
