+/*
+ * Complete controller must fit in one phone landscape window — no scroll.
+ * Typical phone landscape ~667–932 × 320–430; keep chrome tiny and playfield one row.
+ */
+@media (orientation: landscape) and (max-height: 520px) {
+  html:has(.op-pad-page),
+  body.op-pad-page {
+    height: 100%; max-height: 100dvh; overflow: hidden;
+  }
+  .op-pad-page {
