+/** Shoulder / trigger with sketch labels (−Spd / −Ang / +Spd / +Ang). */
+function Adj({
+  code, lab, on, fill, onDown, onUp,
+}: {
+  code: string; lab: string; on: boolean; fill?: number; onDown: () => void; onUp: () => void;
+}) {
+  return (
+    <button
+      type="button"
+      className={`xb-adj ${on ? 'on' : ''}`}
+      style={fill != null ? { ['--p' as string]: `${fill * 100}%` } : undefined}
+      aria-label={`${code} ${lab}`}
+      onPointerDown={(e) => { e.preventDefault(); onDown(); }}
+      onPointerUp={onUp}
+      onPointerLeave={onUp}
+      onPointerCancel={onUp}
+    >
+      <span className="xb-adj-code">{code}</span>
+      <span className="xb-adj-lab">{lab}</span>
+    </button>
+  );
+}
