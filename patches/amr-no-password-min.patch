Subject: [PATCH] Remove 10-character password minimum.

---
 src/components/auth/SignInForm.tsx        | 6 +++---
 src/lib/control/access.ts                 | 3 ++-
 supabase/functions/operator-auth/index.ts | 2 +-
 tests/private-control.test.ts             | 6 +++---
 4 files changed, 9 insertions(+), 8 deletions(-)

diff --git a/src/components/auth/SignInForm.tsx b/src/components/auth/SignInForm.tsx
index 86a89af..5e77bc8 100644
--- a/src/components/auth/SignInForm.tsx
+++ b/src/components/auth/SignInForm.tsx
@@ -4,7 +4,7 @@ import { useState, type FormEvent } from 'react';
 import { useRouter } from 'next/navigation';
 import { useServices } from '@/components/providers/ServicesProvider';
 import { readConfig } from '@/lib/config';
-import { COPY, MIN_PASSWORD, passwordRules } from '@/lib/control/access';
+import { COPY, passwordRules } from '@/lib/control/access';
 import {
   isUsernameShape,
   normalizeUsername,
@@ -139,14 +139,14 @@ export function SignInForm({ redirectTarget }: { redirectTarget: string; startFo
     if (busy) return;
     setPassErr('');
     const rules = passwordRules(password, confirm);
-    if (!rules.length) { setPassErr(`Use at least ${MIN_PASSWORD} characters.`); return; }
+    if (!rules.length) { setPassErr('Enter a password.'); return; }
     if (!rules.match) { setPassErr(COPY.mismatch); return; }
     if (!cfg.supabaseUrl || !cfg.supabaseKey) { setPassErr(COPY.network); return; }
     setBusy(true);
     const claimed = await operatorClaim(cfg.supabaseUrl, cfg.supabaseKey, name, password);
     if (claimed.status !== 'ok') {
       setBusy(false);
-      if (claimed.reason === 'password') setPassErr(`Use at least ${MIN_PASSWORD} characters.`);
+      if (claimed.reason === 'password') setPassErr('Enter a password.');
       else if (claimed.status === 'network' || claimed.status === 'unavailable') setPassErr(COPY.network);
       else setPassErr('Couldn\'t set password. Email amey@amrslam.tech or admin@amrslam.tech.');
       return;
diff --git a/src/lib/control/access.ts b/src/lib/control/access.ts
index b55a704..1960fa0 100644
--- a/src/lib/control/access.ts
+++ b/src/lib/control/access.ts
@@ -1,7 +1,8 @@
 /** Access-flow timings, copy, and parsers. No secrets. */
 
 export const SET_PASSWORD_REDIRECT = 'https://amrslam.tech/set-password';
-export const MIN_PASSWORD = 10;
+/** Non-empty only — no long minimum (Supabase may still enforce its own floor). */
+export const MIN_PASSWORD = 1;
 
 export const COPY = {
   invalid: 'Name or password is incorrect.',
diff --git a/supabase/functions/operator-auth/index.ts b/supabase/functions/operator-auth/index.ts
index affca4f..f8e2b29 100644
--- a/supabase/functions/operator-auth/index.ts
+++ b/supabase/functions/operator-auth/index.ts
@@ -29,7 +29,7 @@ function normUser(u: unknown): string {
 }
 
 function validPassword(p: unknown): p is string {
-  return typeof p === "string" && p.length >= 10 && p.length <= 128;
+  return typeof p === "string" && p.length >= 1 && p.length <= 128;
 }
 
 function randomPassword(): string {
