+.sim-carousel {
+  width: 100%;
+  user-select: none;
+  touch-action: pan-y;
+}
+
+.sim-carousel__stage {
+  position: relative;
+  height: clamp(220px, 56vw, 520px);
+  perspective: 1200px;
+  overflow: visible;
+}
+
+.sim-carousel__slide {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
+  pointer-events: none;
+  transform-style: preserve-3d;
+}
+
+.sim-carousel__slide[data-active] {
+  pointer-events: auto;
+}
+
+.sim-carousel__frame {
+  width: min(100%, 920px);
+  aspect-ratio: 16 / 10;
+  overflow: hidden;
+  border-radius: var(--radius-card);
+  border: 1px solid var(--line-dark);
+  background: #000;
+  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
+}
+
+@media (max-width: 767px) {
+  .sim-carousel__frame {
+    border-radius: 12px;
+  }
+  .sim-carousel__stage {
+    height: clamp(200px, 62vw, 360px);
+  }
+}
+
+.sim-carousel__poster {
+  position: relative;
+  display: grid;
+  place-items: center;
+  width: 100%;
+  height: 100%;
+  padding: 0;
+  border: 0;
+  cursor: pointer;
+  background: #0a0a0e;
+}
+
+.sim-carousel__img {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+.sim-carousel__play {
+  position: relative;
+  z-index: 1;
+  display: grid;
+  place-items: center;
+  width: 72px;
+  height: 72px;
+  border-radius: 999px;
+  background-image: var(--grad-pill);
+}
+
+@media (max-width: 767px) {
+  .sim-carousel__play {
+    width: 56px;
+    height: 56px;
+  }
+}
+
+.sim-carousel__iframe {
+  width: 100%;
+  height: 100%;
+  border: 0;
+}
+
+.sim-carousel__controls {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 1rem;
+  margin-top: 1.25rem;
+}
+
+.sim-carousel__arrow {
+  display: grid;
+  place-items: center;
+  width: 40px;
+  height: 40px;
+  border-radius: 999px;
+  border: 1px solid rgba(255, 255, 255, 0.2);
+  background: rgba(255, 255, 255, 0.06);
+  color: #fff;
+  cursor: pointer;
+}
+
+.sim-carousel__arrow:hover:not(:disabled) {
+  background: rgba(255, 255, 255, 0.12);
+}
+
+.sim-carousel__arrow:disabled {
+  opacity: 0.35;
+  cursor: default;
+}
+
+.sim-carousel__dots {
+  display: flex;
+  gap: 0.5rem;
+}
+
+.sim-carousel__dot {
+  width: 8px;
+  height: 8px;
+  padding: 0;
+  border: 0;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.28);
+  cursor: pointer;
+}
+
+.sim-carousel__dot[data-on] {
+  background: #fff;
+  transform: scale(1.25);
+}
+
+.sim-carousel__meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.75rem;
+  margin-top: 0.75rem;
+  font-size: var(--text-small);
+  color: var(--muted, rgba(255, 255, 255, 0.65));
+}
+
+.sim-carousel__hint {
+  margin-left: auto;
+  opacity: 0.7;
+}
+
+.sim-carousel__desc {
+  flex-basis: 100%;
+  color: rgba(255, 255, 255, 0.6);
+}
+
+.sim-carousel__note {
+  flex-basis: 100%;
+  margin: 0;
+  font-size: 0.75rem;
+  opacity: 0.55;
+}
