diff --git a/src/lib/control/operator-auth.ts b/src/lib/control/operator-auth.ts
new file mode 100644
index 0000000..9c607a6
--- /dev/null
+++ b/src/lib/control/operator-auth.ts
@@ -0,0 +1,97 @@
+/** Client for the `operator-auth` edge function (username allowlist login). */
+
+export type OperatorStatus =
+  | { status: 'ok'; username: string; displayName?: string; needsPassword: boolean }
+  | { status: 'invalid' | 'network' | 'unavailable' | 'forbidden' | 'disabled'; reason?: string };
+
+export type OperatorEmail =
+  | { status: 'ok'; email: string; needsPassword: boolean }
+  | { status: 'invalid' | 'network' | 'unavailable' };
+
+export type OperatorClaim =
+  | { status: 'ok'; email: string }
+  | { status: 'invalid' | 'network' | 'unavailable'; reason?: string };
+
+function fnUrl(supabaseUrl: string) {
+  return `${supabaseUrl.replace(/\/$/, '')}/functions/v1/operator-auth`;
+}
+
+async function post(
+  supabaseUrl: string,
+  key: string,
+  body: Record<string, unknown>,
+): Promise<{ ok: boolean; data: Record<string, unknown>; http: number }> {
+  const res = await fetch(fnUrl(supabaseUrl), {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      apikey: key,
+      Authorization: `Bearer ${key}`,
+    },
+    body: JSON.stringify(body),
+    signal: AbortSignal.timeout(12_000),
+  });
+  let data: Record<string, unknown> = {};
+  try { data = await res.json() as Record<string, unknown>; } catch { /* empty */ }
+  return { ok: res.ok, data, http: res.status };
+}
+
+export async function operatorStatus(supabaseUrl: string, key: string, username: string): Promise<OperatorStatus> {
+  try {
+    const { data, http } = await post(supabaseUrl, key, { action: 'status', username });
+    if (http >= 500) return { status: 'network' };
+    if (data.status === 'ok') {
+      return {
+        status: 'ok',
+        username: String(data.username ?? username),
+        displayName: typeof data.displayName === 'string' ? data.displayName : undefined,
+        needsPassword: Boolean(data.needsPassword),
+      };
+    }
+    if (data.status === 'unavailable') return { status: 'unavailable' };
+    return { status: 'invalid' };
+  } catch {
+    return { status: 'network' };
+  }
+}
+
+export async function operatorEmail(supabaseUrl: string, key: string, username: string): Promise<OperatorEmail> {
+  try {
+    const { data, http } = await post(supabaseUrl, key, { action: 'email', username });
+    if (http >= 500) return { status: 'network' };
+    if (data.status === 'ok' && typeof data.email === 'string') {
+      return { status: 'ok', email: data.email, needsPassword: Boolean(data.needsPassword) };
+    }
+    return { status: 'invalid' };
+  } catch {
+    return { status: 'network' };
+  }
+}
+
+/** First login / forced reset: set password for an allowlisted username, then sign in. */
+export async function operatorClaim(
+  supabaseUrl: string,
+  key: string,
+  username: string,
+  password: string,
+): Promise<OperatorClaim> {
+  try {
+    const { data, http } = await post(supabaseUrl, key, { action: 'claim', username, password });
+    if (http >= 500) return { status: 'network' };
+    if (data.status === 'ok' && typeof data.email === 'string') {
+      return { status: 'ok', email: data.email };
+    }
+    if (data.status === 'unavailable') return { status: 'unavailable' };
+    return { status: 'invalid', reason: typeof data.reason === 'string' ? data.reason : undefined };
+  } catch {
+    return { status: 'network' };
+  }
+}
+
+export function normalizeUsername(raw: string): string {
+  return raw.trim().toLowerCase();
+}
+
+export function isUsernameShape(u: string): boolean {
+  return /^[a-z][a-z0-9_]{1,31}$/.test(u);
+}
diff --git a/supabase/functions/operator-auth/index.ts b/supabase/functions/operator-auth/index.ts
new file mode 100644
index 0000000..affca4f
--- /dev/null
+++ b/supabase/functions/operator-auth/index.ts
@@ -0,0 +1,188 @@
+/**
+ * Invite-only operator auth (no public signup).
+ *
+ * POST JSON:
+ *   { action: "status", username }
+ *   { action: "claim", username, password }   // first-time / forced reset set password
+ *   { action: "email", username }             // resolve auth email for sign-in
+ *   { action: "force_reset_all", secret }     // admin: invalidate passwords, require claim
+ *
+ * verify_jwt=false — gated by permitted_operators allowlist + rate-friendly responses.
+ */
+import "jsr:@supabase/functions-js/edge-runtime.d.ts";
+import { createClient } from "jsr:@supabase/supabase-js@2";
+
+const cors = {
+  "Access-Control-Allow-Origin": "*",
+  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
+};
+
+function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { ...cors, "Content-Type": "application/json" },
+  });
+}
+
+function normUser(u: unknown): string {
+  return String(u ?? "").trim().toLowerCase();
+}
+
+function validPassword(p: unknown): p is string {
+  return typeof p === "string" && p.length >= 10 && p.length <= 128;
+}
+
+function randomPassword(): string {
+  const bytes = new Uint8Array(24);
+  crypto.getRandomValues(bytes);
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: cors });
+  if (req.method !== "POST") return json({ status: "invalid" }, 405);
+
+  const url = Deno.env.get("SUPABASE_URL");
+  const service = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
+  if (!url || !service) return json({ status: "unavailable" }, 503);
+
+  let body: { action?: string; username?: string; password?: string; secret?: string };
+  try {
+    body = await req.json();
+  } catch {
+    return json({ status: "invalid" }, 400);
+  }
+
+  const admin = createClient(url, service, {
+    auth: { autoRefreshToken: false, persistSession: false },
+  });
+
+  const action = body.action ?? "status";
+
+  if (action === "force_reset_all") {
+    const expected = Deno.env.get("OPERATOR_FORCE_RESET_SECRET") ?? "";
+    if (!expected || body.secret !== expected) return json({ status: "forbidden" }, 403);
+
+    const { data: rows, error } = await admin
+      .from("permitted_operators")
+      .select("username, user_id, auth_email")
+      .eq("active", true);
+    if (error) return json({ status: "network" }, 500);
+
+    for (const row of rows ?? []) {
+      if (row.user_id) {
+        const upd = await admin.auth.admin.updateUserById(row.user_id, {
+          password: randomPassword(),
+        });
+        if (upd.error) {
+          /* continue — still mark password_set false */
+        }
+      }
+    }
+
+    const { error: markErr } = await admin
+      .from("permitted_operators")
+      .update({ password_set: false, updated_at: new Date().toISOString() })
+      .eq("active", true);
+    if (markErr) return json({ status: "network" }, 500);
+
+    return json({ status: "ok", reset: (rows ?? []).length });
+  }
+
+  const username = normUser(body.username);
+  if (!username || !/^[a-z][a-z0-9_]{1,31}$/.test(username)) {
+    return json({ status: "invalid" });
+  }
+
+  const { data: row, error } = await admin
+    .from("permitted_operators")
+    .select("username, auth_email, authority_rank, user_id, password_set, active, display_name")
+    .eq("username", username)
+    .maybeSingle();
+
+  if (error) return json({ status: "network" }, 500);
+  if (!row || row.active === false) return json({ status: "invalid" });
+
+  if (action === "status") {
+    return json({
+      status: "ok",
+      username: row.username,
+      displayName: row.display_name ?? row.username,
+      needsPassword: !row.password_set,
+    });
+  }
+
+  if (action === "email") {
+    return json({
+      status: "ok",
+      email: row.auth_email,
+      needsPassword: !row.password_set,
+    });
+  }
+
+  if (action === "claim") {
+    // Allowed when password_set is false (first login or after force reset).
+    if (row.password_set) return json({ status: "invalid", reason: "already_set" });
+    if (!validPassword(body.password)) {
+      return json({ status: "invalid", reason: "password" });
+    }
+
+    let userId = row.user_id as string | null;
+
+    if (!userId) {
+      const created = await admin.auth.admin.createUser({
+        email: row.auth_email,
+        password: body.password,
+        email_confirm: true,
+        app_metadata: {
+          username: row.username,
+          authority_rank: row.authority_rank,
+          provider: "operator",
+        },
+        user_metadata: { username: row.username },
+      });
+      if (created.error || !created.data.user) {
+        const listed = await admin.auth.admin.listUsers({ page: 1, perPage: 1000 });
+        const existing = listed.data?.users?.find((u) => u.email === row.auth_email);
+        if (!existing) return json({ status: "network" }, 500);
+        userId = existing.id;
+        const upd = await admin.auth.admin.updateUserById(userId, {
+          password: body.password,
+          email_confirm: true,
+          app_metadata: {
+            username: row.username,
+            authority_rank: row.authority_rank,
+            provider: "operator",
+          },
+        });
+        if (upd.error) return json({ status: "network" }, 500);
+      } else {
+        userId = created.data.user.id;
+      }
+    } else {
+      const upd = await admin.auth.admin.updateUserById(userId, {
+        password: body.password,
+        email_confirm: true,
+      });
+      if (upd.error) return json({ status: "network" }, 500);
+    }
+
+    await admin.from("permitted_operators").update({
+      user_id: userId,
+      password_set: true,
+      updated_at: new Date().toISOString(),
+    }).eq("username", username);
+
+    await admin.from("operator_profiles").upsert({
+      user_id: userId,
+      email: row.auth_email,
+      display_name: row.display_name ?? row.username,
+      authority_rank: row.authority_rank,
+      updated_at: new Date().toISOString(),
+    });
+
+    return json({ status: "ok", email: row.auth_email });
+  }
+
+  return json({ status: "invalid" }, 400);
+});
