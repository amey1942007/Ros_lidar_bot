From 55f801fb1bb5bcc7e86f5615859b08aca8ea03cd Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 19 Oct 2026 12:17:22 +0000
Subject: [PATCH] Fix control lint so GitHub Pages deploy can publish.

Avoid setState-in-effect for bot persist and Xbox pad reset so CI
lint passes and the name-login build reaches amrslam.tech.
---
 src/components/control/Dashboard.tsx      | 9 +++------
 src/components/control/XboxController.tsx | 8 +++++++-
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/src/components/control/Dashboard.tsx b/src/components/control/Dashboard.tsx
index 29093ae..46e1875 100644
--- a/src/components/control/Dashboard.tsx
+++ b/src/components/control/Dashboard.tsx
@@ -35,7 +35,7 @@ export function Dashboard() {
   const cfg = readConfig();
   const [client, setClient] = useState<SupabaseClient | null>(null);
   const [broadcastClient, setBroadcastClient] = useState<SupabaseClient | null>(null);
-  const [botId, setBotId] = useState<BotId>('hardware-bot');
+  const [botId, setBotId] = useState<BotId>(() => readStoredBot('hardware-bot'));
   const userId = session?.userId ?? null;
   const tel = useControlSession(client, userId, botId, broadcastClient);
 
@@ -67,15 +67,12 @@ export function Dashboard() {
   const joined = useRef(false);
 
   useEffect(() => {
-    const stored = readStoredBot('hardware-bot');
-    setBotId(stored);
-    persistBot(stored);
-  }, []);
+    persistBot(botId);
+  }, [botId]);
 
   const selectBot = useCallback((id: BotId) => {
     if (id === botId) return;
     setBotId(id);
-    persistBot(id);
     joined.current = false;
   }, [botId]);
   const estopTimer = useRef(0);
diff --git a/src/components/control/XboxController.tsx b/src/components/control/XboxController.tsx
index a2ed7d9..c2618cd 100644
--- a/src/components/control/XboxController.tsx
+++ b/src/components/control/XboxController.tsx
@@ -28,14 +28,20 @@ type Props = {
 
 export function XboxController({ open, onClose, canEdit, padLabel, physical, virtualRef }: Props) {
   const [virt, setVirt] = useState<JoyReading>(ZERO);
+  const [wasOpen, setWasOpen] = useState(open);
   const drag = useRef<{ stick: 'L' | 'R'; pointerId: number } | null>(null);
   const leftRef = useRef<HTMLDivElement>(null);
   const rightRef = useRef<HTMLDivElement>(null);
 
+  // Reset pad state when the modal closes (allowed during render — avoids set-state-in-effect lint).
+  if (open !== wasOpen) {
+    setWasOpen(open);
+    if (!open) setVirt(ZERO);
+  }
+
   useEffect(() => {
     if (!open) {
       virtualRef.current = null;
-      setVirt(ZERO);
       return;
     }
     return () => { virtualRef.current = null; };
-- 
